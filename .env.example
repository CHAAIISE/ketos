# Testnet burner account (deploy only, never sent to Vercel). NEAR_ACCOUNT_ID is only needed for the
# first deploy; afterwards it is read from deployments/testnet.json ("owner").
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# Function-call key restricted to the perps contract (written by scripts/deploy-testnet.sh)
KEEPER_PRIVATE_KEY=
# Optional 1Click partner key; empty = unauthenticated quotes with the 25 bps fee subtracted
ONECLICK_JWT=

# Public (web/.env.local)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_PERPS_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
