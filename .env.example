# Testnet funding account; public id can be read from
# deployments/testnet.json ("owner") instead of being stored beside its key.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# Full-access key for ketos.testnet (contract deploy only, never sent to Vercel)
KETOS_PRIVATE_KEY=
# Function-call key restricted to the Ketos contract (written by scripts/deploy-testnet.sh)
KEEPER_PRIVATE_KEY=
# Optional 1Click partner key; empty = unauthenticated quotes with the 25 bps fee subtracted
ONECLICK_JWT=
# Server-only bearer token for /api/keeper/tick; use the same value in Vercel and GitHub Actions.
# Generate it without printing: bash scripts/keeper-launchd.sh ensure-secret
CRON_SECRET=
# Server-only OutLayer HTTPS payment key, scoped to testnet worker execution.
OUTLAYER_PAYMENT_KEY=

# Public (web/.env.local)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_KETOS_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# Optional canonical deployment origin; Vercel's production hostname is used when unset.
NEXT_PUBLIC_SITE_URL=
