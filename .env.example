# Testnet funding account; public id can be read from
# deployments/testnet.json ("owner") instead of being stored beside its key.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# Full-access key for ketos.testnet (contract deploy only, never sent to Vercel)
KETOS_PRIVATE_KEY=
# Optional read-only archival RPC for full deployment snapshots when the normal RPC limits state size.
NEAR_STATE_RPC_URL=
# Function-call key restricted to the Ketos contract (written by scripts/deploy-testnet.sh)
KEEPER_PRIVATE_KEY=
# Optional server-only RPC override for the standalone keeper; defaults to deployments/testnet.json.
KEEPER_RPC_URL=
# Server-only full-access key for the dedicated faucet.ketos.testnet sponsor.
# Generated locally by the faucet deployment script; never use a deployment key here.
FAUCET_PRIVATE_KEY=
# Local-only demo account keys, generated by pnpm demo:session; never upload to a server.
# JSON object mapping the three demo account ids to their testnet keys.
DEMO_TRADER_KEYS=
# Optional 1Click partner key; empty = unauthenticated quotes with the 25 bps fee subtracted
ONECLICK_JWT=
# Server-only bearer token for /api/keeper/tick; use the same value in Vercel and GitHub Actions.
# Generate it without printing: bash scripts/keeper-launchd.sh ensure-secret
CRON_SECRET=
# Leave disabled with the standalone keeper; set 1 only for an authenticated operator fallback.
KEEPER_HTTP_ENABLED=
# Server-only OutLayer HTTPS payment key, scoped to testnet worker execution.
OUTLAYER_PAYMENT_KEY=

# Public (web/.env.local)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_KETOS_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_RPC_URL=https://near-testnet.drpc.org
# Optional canonical deployment origin; Vercel's production hostname is used when unset.
NEXT_PUBLIC_SITE_URL=
