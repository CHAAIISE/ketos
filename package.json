{
  "name": "ketos",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "contracts:build": "bash scripts/build-contracts.sh",
    "contracts:test": "pnpm contracts:build && cd contracts && cargo test --workspace && cargo test --manifest-path tests/Cargo.toml",
    "depth:sample": "tsx scripts/depth-sample.ts"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
